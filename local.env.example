# Copy to local.env (kept out of git) to set this Mac's build settings. build.sh,
# Lab/build.sh and release.sh read it; anything already set in the environment wins.
#
# A signing identity as `security find-identity -v -p codesigning` lists it: its hash or
# its full name. Without one, builds are signed ad hoc. A release that opens without a
# warning on other Macs needs a "Developer ID Application" certificate.
# export POINTERSYNC_SIGN_IDENTITY=${POINTERSYNC_SIGN_IDENTITY:-0123456789ABCDEF0123456789ABCDEF01234567}
#
# The notarytool keychain profile for releases, saved once with
#   xcrun notarytool store-credentials pointersync --apple-id you@example.com --team-id TEAMID
# export POINTERSYNC_NOTARY_PROFILE=${POINTERSYNC_NOTARY_PROFILE:-pointersync}
#
# Where builds go (default ~/Library/Developer/PointerSync).
# export POINTERSYNC_BUILD_DIR=${POINTERSYNC_BUILD_DIR:-$HOME/Library/Developer/PointerSync}
